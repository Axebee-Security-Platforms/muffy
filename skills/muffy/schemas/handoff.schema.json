{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "muffy/handoff.schema.json",
  "title": "Muffy agent hand-off",
  "description": "Machine-readable tail of every subagent final message. The Orchestrator saves it as .team/<task>/handoff/<step>-<role>-r<round>.json and validates it before moving on.",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "task", "step", "round", "status", "paths_written", "blockers", "quality_checks", "summary"],
  "properties": {
    "role": { "enum": ["researcher", "product-manager", "designer", "architect", "devops", "frontend-dev", "backend-dev", "code-reviewer", "qa-tester", "docs-writer", "diagrammer", "debugger", "auditor"] },
    "task": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "step": { "type": "string", "pattern": "^((0|[1-9]|1[0-2])[a-d]?|present)$" },
    "mode": { "enum": [1, 2, 3], "description": "devops only" },
    "round": { "type": "integer", "minimum": 1, "description": "1 = first attempt; +1 per fix round" },
    "status": { "enum": ["done", "blocked", "needs-input", "not-ready"] },
    "verdict": { "enum": ["Approve", "Reject", "Pass", "Fail"] },
    "paths_written": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "deferred_writes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Paths whose content the agent returned as <<<FILE path>>> blocks in its final message because the harness refused its write; the Orchestrator writes them (agents/references/shared/deferred-writes.md). Each is also in paths_written" },
    "ac_ids_done": { "type": "array", "items": { "type": "string", "pattern": "^AC-[0-9]+$" } },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total"],
      "properties": { "passed": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 } }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "problem", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^B-[0-9]+$", "description": "Stable across rounds so a repeated blocker is detectable" },
          "problem": { "type": "string", "minLength": 3, "maxLength": 300 },
          "file": { "type": "string", "pattern": "^[^\\s:]+(:[0-9]+)?$" },
          "ac_ids": { "type": "array", "items": { "type": "string", "pattern": "^AC-[0-9]+$" } },
          "owner": { "enum": ["FE", "BE", "Docs", "Devops", "Architect", "Designer", "PM", "Researcher"] }
        }
      }
    },
    "needs_validation": {
      "type": "array",
      "description": "code-reviewer only: suspected problems the reviewer could not prove from the diff. Not blockers: they never make a Reject and never count toward the loop limit",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^V-[0-9]+$", "description": "Stable across rounds, like a blocker id" },
          "question": { "type": "string", "minLength": 3, "maxLength": 300, "description": "The one thing the owner must confirm or show for this to be closed or promoted to a blocker" },
          "file": { "type": "string", "pattern": "^[^\\s:]+(:[0-9]+)?$" },
          "owner": { "enum": ["FE", "BE", "Docs", "Devops", "Architect", "Designer", "PM", "Researcher"] }
        }
      }
    },
    "quality_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed"],
      "properties": {
        "passed": { "type": "boolean", "description": "true only if every item in the agent's quality-checks.md holds" },
        "failed": { "type": "array", "items": { "type": "string", "minLength": 3 } }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 8,
      "description": "researcher / product-manager / architect (provider choices) / designer (design-system intake) / product-manager in present mode (outline confirmation, missing inputs) / docs-writer (present-mode doc request) only: open questions the Orchestrator relays to the user (status needs-input; on any other status every question is blocking: false and is asked at the next human gate)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "why", "options", "default", "blocking"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[0-9]+$", "description": "Stable across rounds" },
          "question": { "type": "string", "minLength": 3, "maxLength": 200 },
          "why": { "type": "string", "minLength": 3, "maxLength": 200, "description": "What the answer changes" },
          "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
          "default": { "type": "string", "minLength": 1, "maxLength": 80, "description": "The agent's recommended option; used if the user skips" },
          "blocking": { "type": "boolean", "description": "true = cannot continue without the answer; false = proceed on the default" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 3, "maxLength": 200 },
      "description": "Defaults the agent proceeded on without an answer; each is marked [assumed] in its deliverable"
    },
    "contract_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "frontend-dev / backend-dev step 4 (full flow and lite lane): the commit of contract.md + contract/ on feature/<task> the work was built against; check-ownership.mjs compares it with the latest before the step-5 merge" },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence"],
      "description": "debugger step 4a only (fix lane): result of the diagnose round",
      "properties": {
        "status": { "enum": ["known", "unknown", "needs-full-flow"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "cause": { "type": "string", "minLength": 3, "maxLength": 300 },
        "files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "repro": { "type": "string", "minLength": 3, "maxLength": 200, "description": "Failing test, command, URL + viewport or log line that shows the problem" },
        "reason": { "type": "string", "minLength": 3, "maxLength": 300, "description": "Why the cause is unknown, or why the fix needs the full flow" },
        "promote_to": { "enum": ["change-internal", "change-visible", "full"], "description": "needs-full-flow only: the smallest lane that can fix the cause. change-internal: an internal contract or module, nothing a user sees changes beyond the fix; change-visible: a rule, screen or flow users see must change; full: a dependency, the stack, auth or a new capability. Missing = full" },
        "severity": { "enum": ["low", "medium", "high", "critical"], "description": "Impact of the bug (not the effort to fix it); sets the evidence the auditor requires (references/fix-profile.md)" },
        "owner": { "enum": ["FE", "BE", "both"], "description": "Who fixes it at step 4; the Orchestrator spawns that dev" },
        "owner_files": {
          "type": "object",
          "additionalProperties": false,
          "description": "owner both only: the diagnosed files each dev may change (a subset of files)",
          "properties": {
            "FE": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "BE": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "evidence_level", "repro_rerun"],
      "description": "auditor step 4b only (fix lane): verdict on the debugger's cause",
      "properties": {
        "verdict": { "enum": ["confirm", "need-validation", "reject"] },
        "evidence_level": { "enum": ["none", "low", "medium", "high", "critical"], "description": "The highest severity tier whose minimum evidence the diagnosis meets" },
        "repro_rerun": { "enum": ["red", "green", "flaky", "not-run"], "description": "Result of the auditor running the diagnosis repro once" },
        "missing": { "type": "array", "items": { "type": "string", "minLength": 3, "maxLength": 300 }, "description": "need-validation: the evidence the debugger must add, one item each" },
        "reason": { "type": "string", "minLength": 3, "maxLength": 300, "description": "reject: why the cause does not hold" }
      }
    },
    "diagrams_spec": {
      "type": "array",
      "description": "architect / product-manager / designer (screen map) only: diagram content for diagrammer to draw. The spec'ing role never writes the diagram file itself.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "content"],
        "properties": {
          "kind": { "enum": ["architecture", "state", "deployment", "erd", "flow", "screenmap", "gantt", "story-map"] },
          "path": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1 },
          "content": { "type": "object", "description": "The diagram JSON body per agents/references/shared/diagram-style.md for this kind" },
          "contract_ref": { "type": "string", "minLength": 1, "description": "contract.md section this diagram explains" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 12,
      "description": "The choices this round made and why, so a fresh spawn in a later round (silent flows: design-review send-back, loop retries, fix rounds, step-7 docs round 2, stack-learning) reads the reasoning from the file instead of from a continued chat. Required on a done/blocked hand-off of designer, architect, product-manager, frontend-dev, backend-dev, devops and docs-writer outside present mode",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "why"],
        "properties": {
          "id": { "type": "string", "pattern": "^D-[0-9]+$", "description": "Stable across rounds, like a blocker id; a later round that changes a choice re-lists it under the same id" },
          "decision": { "type": "string", "minLength": 3, "maxLength": 200 },
          "why": { "type": "string", "minLength": 3, "maxLength": 300, "description": "The reason, including the alternative that was rejected when one was considered" }
        }
      }
    },
    "brain_note": { "type": "string", "description": "Path of the <brain>/agents/<role>/<task>.md written; absent for code-reviewer (Orchestrator writes it)" },
    "summary": { "type": "string", "minLength": 3, "maxLength": 300 }
  },
  "allOf": [
    { "if": { "properties": { "role": { "enum": ["code-reviewer"] } }, "required": ["role"] }, "then": { "required": ["verdict"], "properties": { "verdict": { "enum": ["Approve", "Reject"] } } } },
    { "if": { "properties": { "role": { "enum": ["qa-tester"] } }, "required": ["role"] }, "then": { "required": ["verdict", "tests"], "properties": { "verdict": { "enum": ["Pass", "Fail"] } } } },
    { "if": { "properties": { "role": { "enum": ["devops"] } }, "required": ["role"] }, "then": { "required": ["mode"] } },
    { "if": { "properties": { "role": { "enum": ["frontend-dev", "backend-dev"] } }, "required": ["role"] }, "then": { "required": ["ac_ids_done"] } },
    { "if": { "properties": { "step": { "enum": ["4a"] } }, "required": ["step"] }, "then": { "required": ["diagnosis"], "properties": { "role": { "enum": ["debugger"] } } } },
    { "if": { "properties": { "step": { "enum": ["4b"] } }, "required": ["step"] }, "then": { "required": ["audit"], "properties": { "role": { "enum": ["auditor"] } } } },
    { "if": { "properties": { "role": { "enum": ["debugger"] } }, "required": ["role"] }, "then": { "properties": { "step": { "enum": ["4a"] } } } },
    { "if": { "properties": { "role": { "enum": ["auditor"] } }, "required": ["role"] }, "then": { "properties": { "step": { "enum": ["4b"] } } } },
    { "if": { "properties": { "audit": { "type": "object" } }, "required": ["audit"] }, "then": { "properties": { "step": { "enum": ["4b"] } } } },
    { "if": { "properties": { "audit": { "properties": { "verdict": { "enum": ["confirm"] } }, "required": ["verdict"] } }, "required": ["audit"] }, "then": { "properties": { "audit": { "properties": { "repro_rerun": { "enum": ["red"] }, "evidence_level": { "enum": ["low", "medium", "high", "critical"] } } } } } },
    { "if": { "properties": { "audit": { "properties": { "verdict": { "enum": ["need-validation"] } }, "required": ["verdict"] } }, "required": ["audit"] }, "then": { "properties": { "audit": { "required": ["missing"], "properties": { "missing": { "minItems": 1 } } } } } },
    { "if": { "properties": { "audit": { "properties": { "verdict": { "enum": ["reject"] } }, "required": ["verdict"] } }, "required": ["audit"] }, "then": { "properties": { "audit": { "required": ["reason"] } } } },
    { "if": { "properties": { "diagnosis": { "properties": { "status": { "enum": ["known"] } }, "required": ["status"] } }, "required": ["diagnosis"] }, "then": { "properties": { "diagnosis": { "required": ["cause", "files", "repro", "severity", "owner"], "properties": { "confidence": { "enum": ["medium", "high"] }, "files": { "minItems": 1 } } } } } },
    { "if": { "properties": { "diagnosis": { "properties": { "status": { "enum": ["unknown", "needs-full-flow"] } }, "required": ["status"] } }, "required": ["diagnosis"] }, "then": { "properties": { "diagnosis": { "required": ["reason"] } } } },
    { "if": { "properties": { "diagnosis": { "type": "object" } }, "required": ["diagnosis"] }, "then": { "properties": { "step": { "enum": ["4a"] } } } },
    { "if": { "properties": { "diagnosis": { "properties": { "owner": { "enum": ["both"] } }, "required": ["owner"] } }, "required": ["diagnosis"] }, "then": { "properties": { "diagnosis": { "required": ["owner_files"], "properties": { "owner_files": { "required": ["FE", "BE"], "properties": { "FE": { "minItems": 1 }, "BE": { "minItems": 1 } } } } } } } },
    { "if": { "properties": { "status": { "enum": ["needs-input"] } }, "required": ["status"] }, "then": { "required": ["questions"], "properties": { "questions": { "minItems": 1 } } } },
    { "if": { "properties": { "status": { "enum": ["done", "blocked", "not-ready"] } }, "required": ["status", "questions"] }, "then": { "properties": { "questions": { "items": { "properties": { "blocking": { "enum": [false] } } } } } } },
    { "if": { "properties": { "questions": { "minItems": 1 } }, "required": ["questions"] }, "then": { "properties": { "role": { "enum": ["researcher", "product-manager", "architect", "devops", "designer", "docs-writer"] } } } },
    { "if": { "properties": { "verdict": { "enum": ["Reject", "Fail"] } }, "required": ["verdict"] }, "then": { "properties": { "blockers": { "minItems": 1 } } } },
    { "if": { "properties": { "quality_checks": { "properties": { "passed": { "enum": [false] } }, "required": ["passed"] } }, "required": ["quality_checks"] }, "then": { "properties": { "status": { "enum": ["not-ready", "blocked", "needs-input"] }, "quality_checks": { "properties": { "failed": { "minItems": 1 } } } } } },
    { "if": { "properties": { "diagrams_spec": { "minItems": 1 } }, "required": ["diagrams_spec"] }, "then": { "properties": { "role": { "enum": ["architect", "product-manager", "designer"] } } } },
    { "if": { "properties": { "role": { "enum": ["designer", "architect", "product-manager", "frontend-dev", "backend-dev", "devops", "docs-writer"] }, "step": { "pattern": "^[0-9]" }, "status": { "enum": ["done", "blocked"] } }, "required": ["role", "step", "status"] }, "then": { "required": ["decisions"], "properties": { "decisions": { "minItems": 1 } } } }
  ]
}
